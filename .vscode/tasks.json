{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "compile-extension",
      "type": "shell",
      "command": "${workspaceFolder}/.vscode/compile-extension.sh",
      "windows": {
        "command": "node",
        "args": ["${workspaceFolder}/.vscode/compile-extension.cjs"]
      },
      "problemMatcher": ["$tsc"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}

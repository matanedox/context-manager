{
  "version": 1,
  "hooks": {
    "sessionStart": [
      { "command": "node .cursor/hooks/log-agent-event.mjs" },
      { "command": "node .cursor/hooks/resolve-persona-context.mjs" }
    ],
    "sessionEnd": [{ "command": "node .cursor/hooks/log-agent-event.mjs" }],
    "beforeSubmitPrompt": [
      { "command": "node .cursor/hooks/log-agent-event.mjs" },
      { "command": "node .cursor/hooks/resolve-persona-context.mjs" }
    ],
    "stop": [{ "command": "node .cursor/hooks/resolve-persona-context.mjs" }],
    "subagentStart": [
      { "command": "node .cursor/hooks/log-agent-event.mjs" },
      { "command": "node .cursor/hooks/resolve-persona-context.mjs" }
    ],
    "subagentStop": [
      { "command": "node .cursor/hooks/log-agent-event.mjs" },
      { "command": "node .cursor/hooks/resolve-persona-context.mjs" }
    ],
    "postToolUseFailure": [{ "command": "node .cursor/hooks/log-agent-event.mjs" }],
    "postToolUse": [{ "command": "node .cursor/hooks/log-agent-event.mjs" }],
    "afterAgentResponse": [{ "command": "node .cursor/hooks/log-agent-event.mjs" }]
  }
}
